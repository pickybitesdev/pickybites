{
  "expo": {
    "name": "PickyBites",
    "slug": "pickybites",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pickybites",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pickybites.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFDFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.pickybites.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "pickybites"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.com.pickybites.app",
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PickyBites needs access to your photos to attach food images to reviews."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PickyBites uses your location to find restaurants near you."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#C96B75"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "92b2518b-84b3-43c1-8997-4357e1e56f12"
      }
    }
  }
}
