# =============================================================================
# Example env — copy to `.env` and fill in real values. Do not commit `.env`.
# =============================================================================

# REQUIRED — Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-public-key-here

# OPTIONAL — local Maps / Places fallback (production: Supabase secret)
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=paste-your-google-places-key-here
# Also enable Maps SDK for iOS + Android on that Google Cloud key.

# OPTIONAL — Sentry
# EXPO_PUBLIC_SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000

# Production secrets (NOT EXPO_PUBLIC — set on Supabase after linking the project):
#   supabase secrets set GOOGLE_PLACES_API_KEY=your-google-places-key
#   supabase secrets set YELP_API_KEY=your-yelp-fusion-key
#   supabase functions deploy places
#   supabase functions deploy yelp
# Or: ./scripts/setup-api-secrets.sh
